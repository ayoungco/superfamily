.venv-transcription/
__pycache__/
*.py[cod]
.DS_Store

# Ultralytics downloads model checkpoints into the current working directory
# unless told otherwise.
*.pt

# Generated transcription/scene-detection pipeline output: reproducible from
# source video and can be large. Reviewed and raw transcript text stays
# tracked (content/transcripts/raw, content/transcripts/reviewed).
content/transcripts/manifest.tsv
content/transcripts/probes/
content/transcripts/audio/
content/transcripts/logs/
content/transcripts/scenes/
content/transcripts/diarization/
# Voiceprints are biometric-ish data (they characterize someone's actual
# voice) and the reference manifest may point at local file paths -- keep
# both out of git even in a private repo.
content/transcripts/speakers.tsv
content/transcripts/speakers/
